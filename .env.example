# Config injected at deploy time. No secret ever reaches the frontend bundle.

# --- Backend: end-user auth (Aditum SSO) ---
ADITUM_JWT_SECRET=           # validates the user's Aditum login token
ADITUM_JWT_ALGORITHM=HS256
ADITUM_LOGIN_URL=https://aditumdata.com
APP_ALLOWED_EMAILS=          # optional comma-list; empty = any signed-in Aditum user

# --- Backend: governed data read (scoped, read-only) ---
ADITUM_API_BASE=             # e.g. https://aditumdata.com
APP_DATA_TOKEN=              # scoped read-only Aditum service token minted for THIS app
APP_CONNECTOR_ID=            # the connector this app reads from
APP_CONNECTORS_JSON=[]       # [{"id","name","type"}] for provenance display
ADITUM_TAG_COLUMN=tag
FRONTEND_ORIGIN=*            # the app's frontend origin (set for CORS in prod)

# --- Frontend (build-time) ---
VITE_API_BASE=               # the app's own FastAPI backend URL
VITE_ADITUM_LOGIN=https://aditumdata.com
